# ==============================================================================
# VANE-SPACE-SLA PLATFORM CONFIGURATION INTERFACE TEMPLATE
# ==============================================================================
# Security Rule: Never commit active keys. Copy to '.env' and populate.

# Symmetric security token used to sign Machine-to-Machine (M2M) OAuth claims
M2M_SIGNING_KEY=your_long_secure_production_signing_key_secret_here

# Telemetry System Configuration Bounds
VALIDATION_TOLERANCE_LEVEL=0.95
MAX_ORCHESTRATION_NODES=32
ISOLATION_ZONE_IDENTIFIER=vane-space-alpha
